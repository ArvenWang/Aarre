NODE_ENV=development
HOST=127.0.0.1
PORT=8788
DATABASE_URL=postgres://aarre:replace-me@127.0.0.1:5432/aarre_sync
PUBLIC_BASE_URL=https://sync.nexvoice.cc
# 多机测试统一使用 manifest key 固定的扩展 ID；逗号分隔，可临时保留旧 ID 过渡
ALLOWED_EXTENSION_IDS=ppjmhonejgpcdmjmcbbdjookgiagambm
TOKEN_PEPPER=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_REDIRECT_URI=https://sync.nexvoice.cc/v1/auth/google/callback
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=aarre-sync-api@0.1.0
TENCENT_CLOUD_SECRET_ID=replace-with-aarre-cam-secret-id
TENCENT_CLOUD_SECRET_KEY=replace-with-aarre-cam-secret-key
TENCENT_CLOUD_REGION=ap-hongkong
# Production default: versioned keyring in this root-owned mode-0600 file.
# Preserve old key versions during rotation. Never commit or log this value.
AARRE_KEK_KEYRING_JSON={"currentVersion":"v1","keys":{"v1":"replace-with-32-random-bytes-as-base64"}}
# Optional future upgrade: SSM or KMS takes precedence over the root-file keyring.
TENCENT_SSM_SECRET_NAME=
TENCENT_KMS_KEY_ID=
COS_BUCKET=replace-with-private-bucket-appid
COS_REGION=ap-hongkong
COS_BACKUP_BUCKET=replace-with-private-backup-bucket-appid
COS_BACKUP_REGION=ap-singapore
ASSET_URL_TTL_SECONDS=300
DEFAULT_QUOTA_BYTES=262144000
# Development/test only. Production never accepts this unversioned fallback.
LOCAL_KEK_BASE64=
