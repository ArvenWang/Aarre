{
  "name": "@aarre/sync-api",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/cli/migrate.js",
    "backup": "node dist/cli/backup.js",
    "restore": "node dist/cli/restore.js",
    "invalidate-backup": "node dist/cli/invalidate-backup.js",
    "measure-capacity": "node dist/cli/measure-capacity.js",
    "process-deletions": "node dist/cli/process-deletions.js",
    "smoke:tencent": "node dist/cli/smoke-tencent.js",
    "migrate:dev": "tsx src/cli/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@sentry/node": "10.69.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "fastify": "5.11.0",
    "jose": "6.2.7",
    "pg": "8.22.0",
    "tencentcloud-sdk-nodejs-common": "4.1.220",
    "tencentcloud-sdk-nodejs-kms": "4.1.281",
    "tencentcloud-sdk-nodejs-ssm": "4.1.275",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
