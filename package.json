{
  "name": "bookmark-layer",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:node": "node scripts/check-node.mjs",
    "check:design": "tsx scripts/check-design-tokens.ts",
    "ui:shots": "node scripts/shoot.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "ui:audit": "node scripts/audit-controls.mjs",
    "check": "npm run check:node && npm run check:design && npm run typecheck && npm run test && npm run build",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:ai-live": "tsx scripts/verify-live-ai.ts",
    "verify:store-assets": "node scripts/verify-store-assets.mjs",
    "measure:covers": "tsx scripts/measure-cover-fallback.ts",
    "package:artifacts": "npm run check && node scripts/package-artifacts.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@mozilla/readability": "0.6.0",
    "clsx": "^2.1.1",
    "idb": "8.0.3",
    "lucide-react": "^1.28.0",
    "pinyin-pro": "3.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "0.2.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.0",
    "magic-string": "0.30.21",
    "playwright": "^1.62.1",
    "rolldown": "1.1.5",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "terser": "^5.43.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
