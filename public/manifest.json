{
  "manifest_version": 3,
  "name": "Bookmark Layer",
  "description": "保留 Chrome 原生书签，同步网页上下文，并用 AI 帮你重新找到真正需要的内容。",
  "version": "0.2.3",
  "minimum_chrome_version": "134",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "contextMenus",
    "identity",
    "identity.email",
    "history",
    "search",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Bookmark Layer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      }
    }
  },
  "omnibox": {
    "keyword": "bl"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
